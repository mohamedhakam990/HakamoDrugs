<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="132dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/drug_new" android:layoutDirection="rtl">
    <ImageView android:id="@+id/drugImage" android:layout_width="88dp" android:layout_height="104dp" android:scaleType="centerInside" android:background="@drawable/image_new" android:padding="6dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="end" android:paddingStart="10dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/hakamo_text" android:textSize="17sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" android:textAlignment="viewEnd"/>
        <TextView android:id="@+id/generic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/hakamo_muted" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewEnd"/>
        <TextView android:id="@+id/active" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/hakamo_primary" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewEnd"/>
        <TextView android:id="@+id/category" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/hakamo_muted" android:textSize="8sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewEnd"/>
        <TextView android:id="@+id/price" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginTop="5dp" android:paddingStart="18dp" android:paddingEnd="18dp" android:gravity="center" android:textColor="#169B72" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/price_chip"/>
    </LinearLayout>
    <TextView android:id="@+id/favorite" android:layout_width="34dp" android:layout_height="34dp" android:gravity="center" android:text="♡" android:textColor="#D23E49" android:textSize="24sp"/>
</LinearLayout>
